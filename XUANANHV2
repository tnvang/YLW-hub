-- SPEED & FLY FIXED
RunService.Stepped:Connect(function()
    pcall(function()
        local char = player.Character
        local hum = char:FindFirstChildOfClass("Humanoid")
        local root = char:FindFirstChild("HumanoidRootPart")
        if hum and root then
            hum.JumpPower = _G.Settings.Jump
            if _G.Settings.Speed > 16 and hum.MoveDirection.Magnitude > 0 then
                root.CFrame = root.CFrame + (hum.MoveDirection * (_G.Settings.Speed/130))
            end
            -- Fly System (Stabilized)
            if _G.Settings.Fly then
                for _,p in pairs(char:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = false end end
                root.Velocity = Vector3.new(0, 0.1, 0) -- Giữ nhân vật không rơi
                if hum.MoveDirection.Magnitude > 0 then
                    root.Velocity = (camera.CFrame.LookVector * hum.MoveDirection.Z + camera.CFrame.RightVector * hum.MoveDirection.X) * _G.Settings.FlySpeed
                end
            end
        end
    end)
end)

